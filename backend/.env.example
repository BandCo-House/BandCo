NODE_ENV=development
BACKEND_PORT=3000
DATABASE_URL=
JWT_SECRET=
# 어드민 토큰 서명용. JWT_SECRET과 다른 값이어야 하며, 없거나 같으면 서버가 시작하지 않는다.
ADMIN_JWT_SECRET=
BCRYPT_SALT_ROUNDS=10
AWS_REGION=ap-northeast-2
AWS_STORAGE_BUCKET=
# Lightsail Resource Access를 사용하지 않는 로컬 환경에서만 설정한다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_CLIENT_ID=
