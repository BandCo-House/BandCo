# Backend-specific copy for sessions started from jamplay/backend.

prefix_rule(
    pattern = ["pnpm", "run", "prisma:migrate:deploy"],
    decision = "forbidden",
    justification = "production 전용 Prisma deploy는 Agent가 실행하지 않습니다. dev 변경은 `pnpm run prisma:migrate:dev`를 사용하세요.",
    match = ["pnpm run prisma:migrate:deploy"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "사용자 변경을 잃을 수 있습니다. 되돌릴 범위를 먼저 확인하세요.",
    match = ["git reset --hard"],
)

prefix_rule(
    pattern = ["git", "clean", "-f"],
    decision = "forbidden",
    justification = "추적되지 않은 작업 파일을 삭제할 수 있습니다. 삭제 대상 확인 없이 실행하지 않습니다.",
    match = ["git clean -f"],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "원격 브랜치 이력을 덮어쓸 수 있습니다. 필요한 경우 사용자가 명시적으로 지시해야 합니다.",
    match = ["git push --force"],
)

prefix_rule(
    pattern = ["npm"],
    decision = "forbidden",
    justification = "JamPlay는 pnpm만 사용합니다. `pnpm` 명령으로 바꾸세요.",
    match = ["npm install", "npm run test"],
)

prefix_rule(
    pattern = ["yarn"],
    decision = "forbidden",
    justification = "JamPlay는 pnpm만 사용합니다. `pnpm` 명령으로 바꾸세요.",
    match = ["yarn install", "yarn test"],
)
