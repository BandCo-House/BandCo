{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://bandco-admin.vercel.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://bandco-admin.vercel.app/admin/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
